rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // user root
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // brands
      match /brands/{brandId} {
        allow read, write: if request.auth.uid == uid;

        // situations: full CRUD
        match /situations/{sitId} {
          allow read, write: if request.auth.uid == uid;
        }

        // methods: full CRUD
        match /methods/{methodId} {
          allow read, write: if request.auth.uid == uid;
        }

        // photos (pool metadata; binaries live in Storage)
        match /photos/{photoId} {
          allow read, write: if request.auth.uid == uid;
        }

        // posts: aiSnapshot is immutable after create
        match /posts/{postId} {
          allow read:   if request.auth.uid == uid;
          allow create: if request.auth.uid == uid;
          allow update: if request.auth.uid == uid
                        && request.resource.data.aiSnapshot == resource.data.aiSnapshot;
          allow delete: if request.auth.uid == uid;
        }

        // renderJobs (placeholder for Phase 03)
        match /renderJobs/{jobId} {
          allow read, write: if request.auth.uid == uid;
        }

        // igFeedSyncStatus: read-only for the brand owner; only the
        // server-side igFeedSync function (admin SDK, bypasses rules) writes.
        match /igFeedSyncStatus/{statusId} {
          allow read: if request.auth.uid == uid;
          allow write: if false;
        }
      }
    }

    // NOTE: a previous catch-all `match /users/{uid}/{document=**}` was REMOVED.
    // Firestore evaluates rule matches as a UNION — any matching `allow` permits
    // the operation; there is no specificity-wins semantic. The catch-all
    // overrode the specific posts/{postId} rule's aiSnapshot immutability guard,
    // letting owners mutate aiSnapshot despite STATE.md documenting it as
    // immutable. Caught 2026-05-08 by tests/integration/aiSnapshotDeny.test.ts.
    //
    // All client-side Firestore writes touch only the enumerated collections
    // above (verified by greppen: brands, methods, photos, posts, renderJobs,
    // situations, igFeedSyncStatus). Server-side admin-SDK writes
    // (learnedPatterns, approvalEvents) bypass these rules entirely.
    //
    // Adding a new client-accessible collection? Add an explicit rule above.

    match /system/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
