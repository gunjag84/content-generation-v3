{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "outDir": "web/dist",
    "rootDir": ".",
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": ["web/src/**/*", "shared/**/*"],
  "exclude": ["node_modules", "web/dist", "server"]
}
