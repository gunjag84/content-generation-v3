{
  "name": "content-generation-v3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "dev:server": "tsx watch server/index.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "start:server": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "tsc -p tsconfig.web.json && vite build --config web/vite.config.ts",
    "preview:web": "vite preview --config web/vite.config.ts",
    "emulators": "firebase emulators:start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "deploy:fns": "bash scripts/deploy-functions.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@google-cloud/kms": "^4.5.0",
    "@google-cloud/tasks": "^6.2.1",
    "express": "^4.21.0",
    "firebase": "^11.0.0",
    "firebase-admin": "^12.6.0",
    "google-auth-library": "^9.14.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "playwright": "^1.59.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.10",
    "vitest": "^2.0.0"
  }
}
