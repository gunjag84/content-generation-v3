# Cloud Run sets this automatically when deployed
PORT=8080

# Local dev uses emulators; set these to point at firebase emulators:start
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Project ID (used by firebase-admin auto-discovery)
GCLOUD_PROJECT=contentai-78bfb

# Cloud Run service URL (set after first deploy; used by requireOidc audience check)
CLOUD_RUN_SERVICE_URL=

# KMS key resource name (production only)
KMS_KEY_NAME=projects/contentai-78bfb/locations/europe-west1/keyRings/user-secrets/cryptoKeys/api-keys

# Anthropic API key — emulator-only fallback.
# When FIRESTORE_EMULATOR_HOST is set, server uses this directly instead of decrypting
# users/{uid}/secrets/apiKeys.anthropic_ciphertext via KMS.
# In production this is always pulled from Firestore + KMS; do NOT set it here for prod.
# ANTHROPIC_API_KEY=sk-ant-...
